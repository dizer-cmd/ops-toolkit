{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case intake decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "case_type",
    "priority",
    "client_ref_present",
    "stated_deadline",
    "routing_queue",
    "missing_information",
    "needs_human_review",
    "review_reasons",
    "summary"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "maxLength": 32,
      "description": "Echoed back from the input so the row can never be misfiled."
    },
    "case_type": {
      "type": "string",
      "enum": [
        "new_claim",
        "additional_evidence",
        "chase",
        "withdrawal",
        "complaint",
        "out_of_scope",
        "unclear"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["P1", "P2", "P3", "P4"]
    },
    "client_ref_present": {
      "type": "boolean",
      "description": "Present and well-formed. Not the same as valid: this tool cannot see the file."
    },
    "stated_deadline": {
      "type": ["string", "null"],
      "maxLength": 64,
      "description": "A date the case itself asserts, copied verbatim. Null if none is stated."
    },
    "routing_queue": {
      "type": "string",
      "enum": [
        "intake_team",
        "evidence_team",
        "complaints",
        "safeguarding",
        "legal",
        "return_to_sender"
      ]
    },
    "missing_information": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "client_reference",
          "claimant_contact_details",
          "incident_date",
          "referenced_attachment_absent",
          "employer_details",
          "identity_verification"
        ]
      }
    },
    "needs_human_review": {
      "type": "boolean",
      "description": "The harness may raise this; nothing may lower it."
    },
    "review_reasons": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "maxLength": 100 }
    },
    "summary": {
      "type": "string",
      "maxLength": 280,
      "description": "One sentence for whoever picks the case up next."
    }
  }
}
